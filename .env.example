# 环境变量模板:复制为 .env.development / .env.production 后按需修改
# 只有 VITE_ 前缀的变量会被注入到客户端代码

# 应用标题(浏览器标签页、侧边栏标题)
VITE_APP_TITLE='后台管理系统'

# 接口基础路径。
#   纯前端演示:保持 '/api',请求由 dev server 的 mock 中间件拦截
#   对接真实后端:改成网关地址,例如 'https://api.example.com' 或 '/api'(由 Nginx 转发)
VITE_APP_BASE_API='/api'

# 是否启用本地 mock(仅开发环境生效,生产构建不会打包 mock)
VITE_APP_USE_MOCK='true'

# 真实后端地址,仅当 VITE_APP_USE_MOCK='false' 时用于 dev server 代理
VITE_SERVER='http://localhost:8100'
