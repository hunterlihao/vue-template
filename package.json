{
  "name": "vue-template",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 + TypeScript + Vite + Element Plus 后台管理模板,内置动态路由权限、按钮级权限与本地 mock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/li-yuanhao04/vue-templet.git"
  },
  "homepage": "https://gitee.com/li-yuanhao04/vue-templet",
  "bugs": {
    "url": "https://gitee.com/li-yuanhao04/vue-templet/issues"
  },
  "type": "module",
  "keywords": [
    "vue3",
    "typescript",
    "vite",
    "element-plus",
    "pinia",
    "admin",
    "template",
    "mock"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --mode development",
    "build:pro": "vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint src",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "fix": "eslint src --fix && stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "format": "prettier --write \"./**/*.{html,vue,ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install",
    "commitlint": "commitlint --config commitlint.config.js -e -V",
    "preinstall": "node ./scripts/preinstall.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/nprogress": "^0.2.3",
    "axios": "^1.9.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.9.10",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.18",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "husky": "^8.0.3",
    "postcss": "^8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "sass": "^1.89.0",
    "stylelint": "^16.19.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-scss": "^15.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.4.3",
    "vite-plugin-mock": "^3.0.2",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.8"
  }
}
